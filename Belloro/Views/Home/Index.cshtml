<!--==================== NEWSLETTER ====================-->
<section class="newsletter section container">
    <div class="newsletter__bg grid">
        <div>
            <h2 class="newsletter__title">Bültenimize <br> Abone Olun</h2>
            <p class="newsletter__description">
                İndirimlerinizi kaçırmayın. İndirimler, kuponlar, hediyeler ve daha fazlasına
                ulaşmak için e-posta bültenimize abone olun.
            </p>
        </div>

        <form action="" class="newsletter__subscribe">
            <input type="email" placeholder="E-posta adresinizi girin" class="newsletter__input">
            <button class="button">
                ABONE OL
            </button>
        </form>
    </div>
</section>