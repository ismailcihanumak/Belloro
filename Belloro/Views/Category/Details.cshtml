@model Belloro.Models.Category

@{
    ViewData["Title"] = "Kategori Detayları";
    Layout = "_adminlayout";
}

<div class="container-fluid p-0">
    <!-- Başlık bölümü - ortalanmış -->
    <div class="text-center mb-4">
        <h1 class="details-title mb-3">Kategori Detayları</h1>
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Category")" class="breadcrumb-link">
                        <i class="bi bi-list-ul me-1"></i>Kategori Listesi
                    </a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Detaylar</li>
            </ol>
        </nav>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="details-form-container">
                <div class="category-info-section">
                    <div class="info-group mb-4">
                        <label class="info-label">
                            <i class="bi bi-folder me-2"></i>Kategori Adı
                        </label>
                        <div class="info-value">
                            @Html.DisplayFor(model => model.Name)
                        </div>
                    </div>

                    <div class="info-group mb-4">
                        <label class="info-label">
                            <i class="bi bi-justify-left me-2"></i>Açıklama
                        </label>
                        <div class="info-value">
                            @Html.DisplayFor(model => model.Description)
                        </div>
                    </div>

                    <div class="info-group mb-4">
                        <label class="info-label">
                            <i class="bi bi-hash me-2"></i>Kategori ID
                        </label>
                        <div class="info-value">
                            @Html.DisplayFor(model => model.CategoryId)
                        </div>
                    </div>

                    <div class="info-group mb-4">
                        <label class="info-label">
                            <i class="bi bi-box-seam me-2"></i>Bu Kategorideki Ürün Sayısı
                        </label>
                        <div class="info-value">
                            @(Model?.Products?.Count() ?? 0) adet
                        </div>
                    </div>
                </div>

                <div class="form-actions text-center mt-4 pt-4">
                    <a asp-action="Edit" asp-route-id="@(Model?.CategoryId)" class="btn btn-warning btn-modern me-3">
                        <i class="bi bi-pencil-square me-2"></i>Düzenle
                    </a>
                    <a asp-action="Index" class="btn btn-secondary btn-modern">
                        <i class="bi bi-arrow-left me-2"></i>Listeye Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        /* Başlık stilleri */
        .details-title {
            font-weight: 700;
            font-size: 2.5rem;
            margin-bottom: 1.5rem;
        }

        body.light-theme .details-title {
            color: #212529;
        }

        body:not(.light-theme) .details-title {
            color: #ffc107;
        }

        /* Breadcrumb stilleri */
        .breadcrumb {
            background: none;
            padding: 0;
            margin-bottom: 0;
        }

        .breadcrumb-link {
            text-decoration: none;
            transition: color 0.2s;
        }

        body.light-theme .breadcrumb-link {
            color: #007bff;
        }

            body.light-theme .breadcrumb-link:hover {
                color: #ffc107;
            }

        body:not(.light-theme) .breadcrumb-link {
            color: #ffc107;
        }

            body:not(.light-theme) .breadcrumb-link:hover {
                color: #ffffff;
            }

        body.light-theme .breadcrumb-item.active {
            color: #6c757d;
        }

        body:not(.light-theme) .breadcrumb-item.active {
            color: #adb5bd;
        }

        /* Form container */
        .details-form-container {
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
        }

        body.light-theme .details-form-container {
            background-color: #ffffff;
            border: 1px solid #e9ecef;
        }

        body:not(.light-theme) .details-form-container {
            background-color: #2c2c2c;
            border: 1px solid #404040;
        }

        /* Bilgi etiketleri */
        .info-label {
            font-weight: 600;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            font-size: 1rem;
        }

        body.light-theme .info-label {
            color: #212529;
        }

        body:not(.light-theme) .info-label {
            color: #ffc107;
        }

        /* Bilgi değerleri */
        .info-value {
            padding: 12px 16px;
            border-radius: 8px;
            border: 2px solid;
            font-size: 1rem;
            min-height: 48px;
            display: flex;
            align-items: center;
        }

        body.light-theme .info-value {
            background-color: #f8f9fa;
            border-color: #e9ecef;
            color: #212529;
        }

        body:not(.light-theme) .info-value {
            background-color: #1a1a1a;
            border-color: #404040;
            color: #ffffff;
        }

        /* Modern butonlar */
        .btn-modern {
            font-size: 1.1rem;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

            .btn-modern::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
                transition: left 0.5s;
            }

            .btn-modern:hover::before {
                left: 100%;
            }

        .btn-warning.btn-modern {
            box-shadow: 0 4px 12px rgba(255, 193, 7, 0.3);
        }

            .btn-warning.btn-modern:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(255, 193, 7, 0.4);
            }

        .btn-secondary.btn-modern {
            box-shadow: 0 4px 12px rgba(108, 117, 125, 0.3);
        }

            .btn-secondary.btn-modern:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(108, 117, 125, 0.4);
            }

        /* Form actions */
        .form-actions {
            border-top: 2px solid;
        }

        body.light-theme .form-actions {
            border-color: #e9ecef;
        }

        body:not(.light-theme) .form-actions {
            border-color: #404040;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}