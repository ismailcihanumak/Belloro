@model Belloro.Models.Category

@{
    ViewData["Title"] = "Kategori Düzenle";
    Layout = "_adminlayout";
}

<div class="container-fluid p-0">
    <!-- Başlık bölümü - ortalanmış -->
    <div class="text-center mb-4">
        <h1 class="edit-title mb-3">Kategori Düzenle</h1>

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Category")" class="breadcrumb-link">
                        <i class="bi bi-list-ul me-1"></i>Kategori Listesi
                    </a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Düzenle</li>
            </ol>
        </nav>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="edit-form-container">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="CategoryId" />

                    <div class="form-group mb-4">
                        <label asp-for="Name" class="form-label">
                            <i class="bi bi-tag me-2"></i>Kategori Adı
                        </label>
                        <input asp-for="Name" class="form-control form-control-modern" placeholder="Kategori adını giriniz" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Açıklama Alanı -->
                    <div class="form-group mb-4">
                        <label asp-for="Description" class="form-label">
                            <i class="bi bi-justify-left me-2"></i>Açıklama
                        </label>
                        <textarea asp-for="Description" class="form-control form-control-modern" rows="4" placeholder="Kategori hakkında açıklama giriniz..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="form-actions text-center mt-4 pt-4">
                        <button type="submit" class="btn btn-warning btn-modern me-3">
                            <i class="bi bi-check-circle me-2"></i>Kaydet
                        </button>
                        <a asp-action="Index" class="btn btn-secondary btn-modern">
                            <i class="bi bi-arrow-left me-2"></i>Listeye Dön
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        /* Başlık stilleri */
        .edit-title {
            font-weight: 700;
            font-size: 2.5rem;
            margin-bottom: 1.5rem;
        }

        body.light-theme .edit-title {
            color: #212529;
        }

        body:not(.light-theme) .edit-title {
            color: #ffc107;
        }

        /* Breadcrumb stilleri */
        .breadcrumb {
            background: none;
            padding: 0;
            margin-bottom: 0;
        }

        .breadcrumb-link {
            text-decoration: none;
            transition: color 0.2s;
        }

        body.light-theme .breadcrumb-link {
            color: #007bff;
        }

            body.light-theme .breadcrumb-link:hover {
                color: #ffc107;
            }

        body:not(.light-theme) .breadcrumb-link {
            color: #ffc107;
        }

            body:not(.light-theme) .breadcrumb-link:hover {
                color: #ffffff;
            }

        body.light-theme .breadcrumb-item.active {
            color: #6c757d;
        }

        body:not(.light-theme) .breadcrumb-item.active {
            color: #adb5bd;
        }

        /* Form container */
        .edit-form-container {
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
        }

        body.light-theme .edit-form-container {
            background-color: #ffffff;
            border: 1px solid #e9ecef;
        }

        body:not(.light-theme) .edit-form-container {
            background-color: #2c2c2c;
            border: 1px solid #404040;
        }

        /* Form etiketleri */
        .form-label {
            font-weight: 600;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
        }

        body.light-theme .form-label {
            color: #212529;
        }

        body:not(.light-theme) .form-label {
            color: #ffc107;
        }

        /* Modern form kontrolleri */
        .form-control-modern {
            border-radius: 8px;
            border: 2px solid;
            padding: 12px 16px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        body.light-theme .form-control-modern {
            background-color: #ffffff;
            border-color: #e9ecef;
            color: #212529;
        }

            body.light-theme .form-control-modern:focus {
                border-color: #ffc107;
                box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
            }

            body.light-theme .form-control-modern::placeholder {
                color: #6c757d;
            }

        body:not(.light-theme) .form-control-modern {
            background-color: #1a1a1a;
            border-color: #404040;
            color: #ffffff;
        }

            body:not(.light-theme) .form-control-modern:focus {
                border-color: #ffc107;
                box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
            }

            body:not(.light-theme) .form-control-modern::placeholder {
                color: #adb5bd;
            }

        /* Modern butonlar */
        .btn-modern {
            font-size: 1.1rem;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

            .btn-modern::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
                transition: left 0.5s;
            }

            .btn-modern:hover::before {
                left: 100%;
            }

        .btn-warning.btn-modern {
            box-shadow: 0 4px 12px rgba(255, 193, 7, 0.3);
        }

            .btn-warning.btn-modern:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(255, 193, 7, 0.4);
            }

        .btn-secondary.btn-modern {
            box-shadow: 0 4px 12px rgba(108, 117, 125, 0.3);
        }

            .btn-secondary.btn-modern:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(108, 117, 125, 0.4);
            }

        /* Form actions */
        .form-actions {
            border-top: 2px solid;
        }

        body.light-theme .form-actions {
            border-color: #e9ecef;
        }

        body:not(.light-theme) .form-actions {
            border-color: #404040;
        }

        /* Responsive tasarım */
        @@media (max-width: 768px) {
            .edit-title {
                font-size: 2rem;
            }

            .edit-form-container {
                padding: 20px;
            }

            .btn-modern {
                padding: 10px 20px;
                font-size: 1rem;
            }

            .col-md-6 {
                padding: 0 15px;
            }
        }

        @@media (max-width: 576px) {
            .btn-modern {
                width: 100%;
                margin-bottom: 10px;
            }

                .btn-modern.me-3 {
                    margin-right: 0 !important;
                }
        }
    </style>
}