@model Belloro.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Kontrol Paneli";
    Layout = "~/Views/Shared/_adminlayout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&display=swap" rel="stylesheet">

<div class="container-fluid p-0">
    <div class="text-center mb-4">
        <div class="dashboard-header-top">
            <span class="current-time">
                <i class="bi bi-clock me-2"></i>
                <span id="currentDateTime"></span>
            </span>
            <span class="current-user ms-4">
                <i class="bi bi-person-circle me-2"></i>
                <span>@(User.Identity?.Name ?? "Yönetici")</span>
            </span>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="stat-card bg-primary">
                <div class="stat-content">
                    <h3>@Model.TotalProducts</h3>
                    <p>Toplam Ürün</p>
                </div>
                <i class="bi bi-box-seam stat-icon"></i>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="stat-card bg-success">
                <div class="stat-content">
                    <h3>@Model.TotalCategories</h3>
                    <p>Toplam Kategori</p>
                </div>
                <i class="bi bi-folder stat-icon"></i>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="stat-card bg-warning">
                <div class="stat-content">
                    <h3>@Model.TotalOrders</h3>
                    <p>Toplam Sipariş</p>
                </div>
                <i class="bi bi-cart-check stat-icon"></i>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="stat-card bg-danger">
                <div class="stat-content">
                    <h3>₺@((Model.RecentOrders?.Sum(o => o.Amount) ?? 0).ToString("N0"))</h3>
                    <p>Toplam Satış</p>
                </div>
                <i class="bi bi-graph-up-arrow stat-icon"></i>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Son Siparişler -->
        <div class="col-lg-8 mb-4">
            <div class="card dashboard-card">
                <div class="card-header text-center">
                    <h5 class="card-title mb-0 d-inline-block">
                        <i class="bi bi-clock-history me-2"></i>Son Siparişler
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                    {
                        <div class="table-responsive">
                            <table class="table belloro-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Sipariş No</th>
                                        <th>Müşteri</th>
                                        <th>Ürün</th>
                                        <th>Tutar</th>
                                        <th>Durum</th>
                                        <th>Tarih</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.RecentOrders)
                                    {
                                        <tr>
                                            <td><strong>@order.OrderNumber</strong></td>
                                            <td>@order.CustomerName</td>
                                            <td>@order.ProductName</td>
                                            <td>
                                                <div class="fiyat-ortala">
                                                    <span class="fiyat-rakam">@order.Amount.ToString("N0")</span>
                                                    <span class="fiyat-tl">₺</span>
                                                </div>
                                            </td>
                                            <td>
                                                @if (order.Status == "Tamamlandı")
                                                {
                                                    <span class="badge bg-success">@order.Status</span>
                                                }
                                                else if (order.Status == "İşlemde")
                                                {
                                                    <span class="badge bg-warning text-dark">@order.Status</span>
                                                }
                                                else if (order.Status == "Kargoda")
                                                {
                                                    <span class="badge bg-info text-dark">@order.Status</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@order.Status</span>
                                                }
                                            </td>
                                            <td>@order.OrderDate.ToString("dd.MM.yyyy")</td>
                                            <td>
                                                <div class="order-actions d-flex justify-content-center gap-2">
                                                    <a href="@Url.Action("Edit", "Orders", new { orderNumber = order.OrderNumber })" class="btn-action edit" title="Düzenle"><i class="bi bi-pencil-square"></i></a>
                                                    <a href="@Url.Action("Details", "Orders", new { orderNumber = order.OrderNumber })" class="btn-action details" title="Detay"><i class="bi bi-eye"></i></a>
                                                    <a href="@Url.Action("Delete", "Orders", new { orderNumber = order.OrderNumber })" class="btn-action delete" title="Sil"><i class="bi bi-trash"></i></a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state text-center py-5">
                            <i class="bi bi-cart-x display-1 text-muted"></i>
                            <p class="text-muted mt-3">Henüz sipariş bulunmuyor</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- En Çok Satan Ürünler -->
        <div class="col-lg-4 mb-4">
            <div class="card dashboard-card">
                <div class="card-header text-center">
                    <h5 class="card-title mb-0 d-inline-block">
                        <i class="bi bi-trophy me-2"></i>En Çok Satan Ürünler
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.TopSellingProducts != null && Model.TopSellingProducts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table belloro-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Ürün Adı</th>
                                        <th>Satış</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in Model.TopSellingProducts)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="top-product-img me-3 flex-shrink-0">
                                                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                                                        {
                                                            <img src="@product.ImageUrl" alt="@product.ProductName" class="rounded">
                                                        }
                                                        else
                                                        {
                                                            <div class="no-image d-flex align-items-center justify-content-center rounded">
                                                                <i class="bi bi-image"></i>
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="top-product-info text-start" style="text-align:left;">
                                                        <h6 class="mb-1 top-product-title" style="text-align:left;">@product.ProductName</h6>
                                                        <small class="text-muted top-product-category" style="display:block;text-align:left;">@product.CategoryName</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="sales-info text-center">
                                                    <div class="fiyat-ortala">
                                                        <span class="fiyat-rakam">@product.Price.ToString("N0")</span>
                                                        <span class="fiyat-tl">₺</span>
                                                    </div>
                                                    <span class="badge bg-primary sales-count mt-2">
                                                        <i class="bi bi-box me-1"></i>@product.SalesCount Adet
                                                    </span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state text-center py-4">
                            <i class="bi bi-box display-4 text-muted"></i>
                            <p class="text-muted mt-3 mb-0">Henüz satış verisi yok</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateDateTime() {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            const localTime = `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
            const element = document.getElementById('currentDateTime');
            if (element) element.textContent = localTime;
        }
        setInterval(updateDateTime, 1000);
        document.addEventListener('DOMContentLoaded', updateDateTime);
    </script>
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .products-title {
            font-weight: 700;
            font-size: 2.5rem;
            margin-bottom: 1.5rem;
        }

        .dashboard-header-top {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 2rem;
            margin-bottom: 0.5rem;
        }

        .current-time, .current-user {
            font-size: 1rem;
            color: #6c757d;
        }

        .stat-card {
            background: linear-gradient(135deg, var(--bs-primary), #0056b3);
            color: white;
            padding: 20px;
            border-radius: 12px;
            position: relative;
            overflow: hidden;
            transition: transform 0.2s ease;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            margin-bottom: 0 !important;
        }

            .stat-card:hover {
                transform: translateY(-2px);
            }

            .stat-card.bg-success {
                background: linear-gradient(135deg, var(--bs-success), #0d5345);
            }

            .stat-card.bg-warning {
                background: linear-gradient(135deg, var(--bs-warning), #b8860b);
            }

            .stat-card.bg-info {
                background: linear-gradient(135deg, var(--bs-info), #087990);
            }

        .stat-content h3 {
            font-size: 2.2rem;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .stat-content p {
            margin: 0;
            opacity: 0.9;
            font-size: 0.95rem;
        }

        .stat-icon {
            position: absolute;
            right: 20px;
            top: 20px;
            font-size: 2.5rem;
