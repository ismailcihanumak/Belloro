                font-size: 0.9rem;
                text-transform: uppercase;
            }

            .belloro-table tbody tr {
                transition: all 0.3s ease;
            }

                .belloro-table tbody tr:hover {
                    background-color: rgba(255, 193, 7, 0.08);
                    transform: translateY(-1px);
                    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
                }

        .order-actions {
            display: flex;
            justify-content: center;
            gap: 0.4rem;
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 35px;
            height: 35px;
            border-radius: 6px;
            border: none;
            background: transparent;
            font-size: 1.2rem;
            color: #666;
            transition: background 0.2s, color 0.2s;
            box-shadow: none;
            outline: none;
        }

            .btn-action.edit:hover, .btn-action.edit:focus {
                background: #e2f0fb;
                color: #0d6efd;
            }

            .btn-action.details:hover, .btn-action.details:focus {
                background: #e0fbe2;
                color: #198754;
            }

            .btn-action.delete:hover, .btn-action.delete:focus {
                background: #fae2e2;
                color: #dc3545;
            }

        .fiyat-ortala {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .fiyat-rakam {
            font-family: 'Montserrat', 'Inter', Arial, sans-serif;
            font-weight: 600;
            font-size: 1.06rem;
            letter-spacing: 0.5px;
            margin-bottom: 2px;
            margin-top: 4px;
            color: #212529;
            transition: color 0.2s;
        }

        .fiyat-tl {
            font-family: 'Montserrat', 'Inter', Arial, sans-serif;
            font-weight: 700;
            font-size: 1.04rem;
            color: #ffc107;
            margin-top: 0;
            line-height: 1;
            letter-spacing: 0.09em;
            transition: color 0.2s;
        }

        .empty-state {
            color: #6c757d;
        }

        .top-products-list {
            max-height: 480px;
            overflow-y: auto;
        }

        .top-product-item {
            background: var(--bs-body-bg, #fff);
            min-width: 0;
            border: 1px solid #f1f1f1;
            transition: background 0.2s, box-shadow 0.2s;
        }

            .top-product-item:hover {
                background-color: #f8f9fa;
                box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            }

        .top-product-img {
            width: 48px;
            height: 48px;
        }

            .top-product-img img, .no-image {
                width: 48px;
                height: 48px;
                object-fit: cover;
            }

        /* Ürün adı ve kategori adı sola dayalı */
        .top-product-info {
            min-width: 0;
            text-align: left !important;
        }

        .top-product-title {
            font-size: 1rem;
            font-weight: 600;
            word-wrap: break-word;
            white-space: normal;
            text-align: left !important;
        }

        .top-product-category {
            font-size: 0.85rem;
            word-wrap: break-word;
            white-space: normal;
            display: block;
            text-align: left !important;
        }

        .sales-info {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .sales-count {
            font-size: 0.85rem;
            font-weight: 500;
            background: linear-gradient(135deg, #0d6efd, #1e90ff);
            color: #fff;
            padding: 0.3rem 0.6rem;
        }

        .price {
            font-size: 1rem;
            font-weight: 700;
            margin-left: 0.5rem;
        }

        .no-image {
            background: #f8f9fa;
            color: #6c757d;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
        }

        .dashboard-header-top {
            position: fixed;
            top: 0;
            right: 0;
            height: 56px;
            display: flex;
            align-items: center;
            z-index: 10;
            background: transparent;
            padding: 0 34px 0 0;
            margin-top: 12px;
        }

        .dashboard-header-top-content {
            display: flex;
            align-items: center;
            gap: 22px;
        }

        .header-icon {
            font-size: 1.22rem;
            display: flex;
            align-items: center;
            opacity: 0.98;
        }

        .header-date, .header-time, .header-username, .header-icon {
            font-size: 1.08rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            color: #6c757d;
            transition: color 0.2s;
        }

        .header-date {
            margin-left: 5px;
            margin-right: 7px;
        }

        .header-time {
            margin-right: 18px;
        }

        .header-username {
            margin-left: 6px;
            font-weight: 700;
        }

        /* ===============================================
                           KARANLIK MOD - RESİMDEKİ TABLO TASARIMI
                           =============================================== */

        body:not(.light-theme) {
            background: #1a1a1a !important;
            color: #FFD700 !important;
        }

            /* Karanlık mod tablo stilleri - resimdeki tasarıma uygun */
