                    background: rgba(220, 53, 69, 0.1) !important;
                    color: #dc3545 !important;
                    border-color: #dc3545;
                }

            /* Top products karanlık mod */
            body:not(.light-theme) .top-product-item {
                background: #2a2a2a !important;
                border: 1px solid #404040 !important;
