            }

                body:not(.light-theme) .top-product-item:hover {
                    background: #333333 !important;
                    border-color: #FFD700;
                    box-shadow: 0 4px 12px rgba(255, 215, 0, 0.15) !important;
                }

            body:not(.light-theme) .top-product-title {
                color: #FFD700 !important;
                font-weight: 600;
            }

            body:not(.light-theme) .top-product-category {
                color: #ccc !important;
            }

            body:not(.light-theme) .price {
                color: #FFD700 !important;
                text-shadow: 0 0 4px rgba(255, 215, 0, 0.3);
                font-weight: 700;
            }

            body:not(.light-theme) .sales-count {
                background: linear-gradient(135deg, #FFD700, #FFA500) !important;
                color: #1a1a1a !important;
                font-weight: 600;
            }

            /* Empty state karanlık mod */
            body:not(.light-theme) .empty-state {
                color: #666 !important;
            }

                body:not(.light-theme) .empty-state i {
                    color: #444 !important;
                }

            /* No image placeholder karanlık mod */
            body:not(.light-theme) .no-image {
                background: #333333 !important;
                color: #666 !important;
                border: 1px solid #404040;
            }

            /* Table responsive karanlık mod */
            body:not(.light-theme) .table-responsive {
                border: 1px solid #404040;
                border-radius: 8px;
                overflow: hidden;
            }

            /* Header stilleri karanlık mod */
            body:not(.light-theme) .header-date,
            body:not(.light-theme) .header-time,
            body:not(.light-theme) .header-username,
