@model Belloro.Models.Product

@{
    ViewData["Title"] = "Ürün Düzenle";
    Layout = "_adminlayout";
}

<div class="container-fluid p-0">
    <div class="text-center mb-4">
        <h1 class="edit-title mb-3">Ürün Düzenle</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Products")" class="breadcrumb-link">
                        <i class="bi bi-list-ul me-1"></i>Ürün Listesi
                    </a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Düzenle</li>
            </ol>
        </nav>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="edit-form-container">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="ProductId" />
                    <input type="hidden" asp-for="SalesCount" />
                    <input type="hidden" asp-for="ImageUrl" />

                    <div class="form-group mb-4">
                        <label asp-for="Name" class="form-label">
                            <i class="bi bi-tag me-2"></i>Ürün Adı
                        </label>
                        <input asp-for="Name" class="form-control form-control-modern" placeholder="Ürün adını giriniz..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-4">
                        <label asp-for="Description" class="form-label">
                            <i class="bi bi-card-text me-2"></i>Açıklama
                        </label>
                        <textarea asp-for="Description" class="form-control form-control-modern" rows="4" placeholder="Ürün açıklamasını giriniz..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-4">
                        <label asp-for="Price" class="form-label">
                            <i class="bi bi-currency-exchange me-2"></i>Fiyat (TL)
                        </label>
                        <div class="input-group">
                            <input asp-for="Price" class="form-control form-control-modern" type="number" step="0.01" placeholder="0,00" />
                            <span class="input-group-text price-suffix">₺</span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-4">
                        <label asp-for="CategoryId" class="form-label">
                            <i class="bi bi-folder me-2"></i>Kategori
                        </label>
                        <select asp-for="CategoryId" class="form-select form-control-modern" asp-items="ViewBag.CategoryId">
                            <option value="">-- Kategori Seçin --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-4">
                        <label class="form-label"><i class="bi bi-image me-2"></i>Ürün Görseli</label>
                        <div class="image-upload-options">
                            <label class="form-label upload-label" for="imageInput">
                                <i class="bi bi-upload me-1"></i>Dosya yükle
                            </label>
                            <input type="file" name="ImageFile" id="imageInput" class="form-control-modern custom-file-input" accept="image/*" />
                        </div>
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-4 image-preview-wrapper">
                        <label class="form-label">
                            <i class="bi bi-eye me-2"></i>Görsel Önizleme
                        </label>
                        <div id="imageContainer" class="image-preview-container">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img id="productImage" src="@Model.ImageUrl" alt="@Model.Name" class="preview-image" />
                            }
                            else
                            {
                                <div class="no-image-preview" id="noImageBox" style="display:flex;">
                                    <i class="bi bi-image"></i>
                                    <span>Resim Yok</span>
                                </div>
                            }
                        </div>
                        <div id="cancelButtonContainer" style="display:none;">
                            <button type="button" id="cancelImageBtn" class="btn btn-cancel-image">
                                <i class="bi bi-x-circle me-2"></i>Seçimi İptal Et
                            </button>
                        </div>
                    </div>
                    <div class="form-group mb-4">
                        <div class="form-check">
                            <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                            <label asp-for="IsFeatured" class="form-check-label">
                                <i class="bi bi-star me-2"></i>Öne Çıkan Ürün
                            </label>
                        </div>
                        <div class="form-check">
                            <input asp-for="IsNew" class="form-check-input" type="checkbox" />
                            <label asp-for="IsNew" class="form-check-label">
                                <i class="bi bi-badge-wc me-2"></i>Yeni Ürün
                            </label>
                        </div>
                    </div>
                    <div class="form-actions text-center mt-4 pt-4">
                        <button type="submit" class="btn btn-warning btn-modern me-3">
                            <i class="bi bi-check-circle me-2"></i>Kaydet
                        </button>
                        <a asp-action="Index" class="btn btn-secondary btn-modern">
                            <i class="bi bi-arrow-left me-2"></i>Listeye Dön
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const imageInput = document.getElementById('imageInput');
            const cancelButtonContainer = document.getElementById('cancelButtonContainer');
            const cancelImageBtn = document.getElementById('cancelImageBtn');
            const imageContainer = document.getElementById('imageContainer');
            const noImageBox = document.getElementById('noImageBox');
            let originalImageSrc = '@(Model.ImageUrl ?? "")';
            let currentImageIsOriginal = true;

            function updateCancelBtnVisibility(visible) {
                cancelButtonContainer.style.display = visible ? 'block' : 'none';
            }
            updateCancelBtnVisibility(false);

            imageInput.addEventListener('change', function (event) {
                const file = event.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        showImagePreview(e.target.result);
                        currentImageIsOriginal = false;
                        updateCancelBtnVisibility(true);
                    }
                    reader.readAsDataURL(file);
                }
            });

            cancelImageBtn.addEventListener('click', function () {
                if (originalImageSrc) {
                    showImagePreview(originalImageSrc);
                } else {
                    hideImagePreview();
                }
                imageInput.value = '';
                currentImageIsOriginal = true;
                updateCancelBtnVisibility(false);
            });

            function showImagePreview(src) {
                imageContainer.innerHTML = '';
                const img = document.createElement('img');
                img.src = src;
                img.className = 'preview-image';
                img.alt = 'Önizleme';
                img.onerror = function () {
                    hideImagePreview();
                    alert('Resim yüklenemedi. Lütfen geçerli bir dosya seçin.');
                };
                imageContainer.appendChild(img);
            }

            function hideImagePreview() {
                imageContainer.innerHTML = '';
                noImageBox.style.display = 'flex';
                imageContainer.appendChild(noImageBox);
            }
        });
    </script>
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .edit-title {
    font-weight: 700;
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
}

body.light-theme .edit-title {
    color: #212529;
}

body:not(.light-theme) .edit-title {
    color: #ffc107;
}

.breadcrumb {
    background: none;
    padding: 0;
    margin-bottom: 0;
}

.breadcrumb-link {
    text-decoration: none;
    transition: color 0.2s;
}

body.light-theme .breadcrumb-link {
    color: #007bff;
}
body.light-theme .breadcrumb-link:hover {
    color: #ffc107;
}
body:not(.light-theme) .breadcrumb-link {
    color: #ffc107;
}
body:not(.light-theme) .breadcrumb-link:hover {
    color: #ffffff;
}
body.light-theme .breadcrumb-item.active {
    color: #6c757d;
}
body:not(.light-theme) .breadcrumb-item.active {
    color: #adb5bd;
}

/* Form container */
.edit-form-container {
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    margin-bottom: 30px;
}
body.light-theme .edit-form-container {
    background-color: #ffffff;
    border: 1px solid #e9ecef;
}
body:not(.light-theme) .edit-form-container {
    background-color: #2c2c2c;
    border: 1px solid #404040;
}

.form-label {
    font-weight: 600;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
}
body.light-theme .form-label {
    color: #212529;
}
body:not(.light-theme) .form-label {
    color: #ffc107;
}

.form-control-modern {
    border-radius: 8px;
    border: 2px solid;
    padding: 12px 16px;
    font-size: 1rem;
    transition: all 0.3s ease;
}
body.light-theme .form-control-modern {
    background-color: #ffffff;
    border-color: #e9ecef;
    color: #212529;
}
body.light-theme .form-control-modern:focus {
    border-color: #ffc107;
    box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
}
body.light-theme .form-control-modern::placeholder {
    color: #6c757d;
}
body:not(.light-theme) .form-control-modern {
    background-color: #1a1a1a;
    border-color: #404040;
    color: #ffffff;
}
body:not(.light-theme) .form-control-modern:focus {
    border-color: #ffc107;
    box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
}
body:not(.light-theme) .form-control-modern::placeholder {
    color: #adb5bd;
}

/* Animasyonlu buton ortak */
.animated-btn {
    font-size: 1.05rem;
    padding: 9px 18px;
    border-radius: 8px;
    font-weight: 600;
    position: relative;
    overflow: hidden;
    transition: background 0.3s, color 0.3s, border 0.3s, box-shadow 0.3s, transform 0.18s cubic-bezier(.4,0,.2,1);
}
.animated-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    transition: left 0.5s;
    z-index: 0;
    opacity: 0.5;
}
.animated-btn:hover::before {
    left: 100%;
}

/* Kaydet & Listeye dön */
.btn-modern {
    font-size: 1.1rem;
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 600;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}
.btn-modern::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.5s;
}
.btn-modern:hover::before {
    left: 100%;
}
.btn-warning.btn-modern {
    box-shadow: 0 4px 12px rgba(255, 193, 7, 0.3);
}
.btn-warning.btn-modern:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 193, 7, 0.4);
}
.btn-secondary.btn-modern {
    box-shadow: 0 4px 12px rgba(108, 117, 125, 0.3);
}
.btn-secondary.btn-modern:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(108, 117, 125, 0.4);
}

        /* Dosya yükle butonu */
        .custom-file-input {
            opacity: 0;
            width: 0.1px;
            height: 0.1px;
            position: absolute;
            z-index: -1;
        }

        .upload-label {
            display: inline-block;
            padding: 7px 20px;
            margin-bottom: 0;
            border-radius: 8px;
            font-weight: bold;
            font-size: 1rem;
            cursor: pointer;
            border: 2px solid #e9ecef;
            background: #fff;
            color: #333;
            margin-right: 14px;
            position: relative;
            z-index: 1;
            transition: color 0.2s;
        }

            .upload-label i {
                color: inherit;
                transition: color 0.2s;
            }
        /* Açık Tema */
        body.light-theme .upload-label {
            background: #fff;
            color: #232323;
            border-color: #d0d0d0;
        }

            body.light-theme .upload-label i {
                color: inherit;
            }

            body.light-theme .upload-label:hover,
            body.light-theme .upload-label:focus {
                color: #ff9800;
            }

                body.light-theme .upload-label:hover i,
                body.light-theme .upload-label:focus i {
                    color: #ff9800;
                }


        /* Koyu Tema */
        body:not(.light-theme) .upload-label {
            background: #232323;
            color: #fff;
            border-color: #404040;
        }

            body:not(.light-theme) .upload-label i {
                color: inherit;
            }

            body:not(.light-theme) .upload-label:hover,
            body:not(.light-theme) .upload-label:focus {
                color: #ffc107;
            }

                body:not(.light-theme) .upload-label:hover i,
                body:not(.light-theme) .upload-label:focus i {
                    color: #ffc107;
                }

/* Dosya seçildi/yok yazısı */
.image-upload-options {
    display: flex;
    align-items: center;
    gap: 10px;
}
.selected-file-name {
    font-size: 1rem;
    margin-left: 10px;
    color: #ffc107;
    font-weight: 500;
}

/* Seçimi iptal et butonu */
.btn-cancel-image {
    margin: 10px auto 0 auto;
    display: block;
    font-size: 1rem;
    font-weight: 500;
    border-radius: 8px;
    padding: 7px 24px;
    border: 2px solid #dc3545;
    background: #fff;
    color: #dc3545;
    position: relative;
    overflow: hidden;
    z-index: 1;
    transition: 
        background 0.25s cubic-bezier(.4,0,.2,1),
        color 0.22s cubic-bezier(.4,0,.2,1),
        border 0.22s cubic-bezier(.4,0,.2,1),
        box-shadow 0.25s cubic-bezier(.4,0,.2,1);
}
.btn-cancel-image span, .btn-cancel-image i {
    position: relative;
    z-index: 2;
    transition: color 0.18s cubic-bezier(.4,0,.2,1);
}

/* Hover'da arka plan kırmızı, yazı rengi değişir */
.btn-cancel-image:hover {
    background: #dc3545;
    color: #fff !important; /* Açık tema: siyah yazı */
}
.btn-cancel-image:hover span,
.btn-cancel-image:hover i {
    color: #fff !important;
}

/* Koyu tema */
body:not(.light-theme) .btn-cancel-image {
    background: #232323;
    color: #dc3545;
    border: 2px solid #dc3545;
}
body:not(.light-theme) .btn-cancel-image:hover {
    background: #dc3545;
    color: #fff !important;
}
body:not(.light-theme) .btn-cancel-image:hover span,
body:not(.light-theme) .btn-cancel-image:hover i {
    color: #fff !important;
}

/* Form actions */
.form-actions {
    border-top: 2px solid;
}
body.light-theme .form-actions {
    border-color: #e9ecef;
}
body:not(.light-theme) .form-actions {
    border-color: #404040;
}

/* Görsel kutusu ve önizleme */
.image-preview-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 200px;
    height: 200px;
    border: 1px solid;
    border-radius: 16px;
    margin: 0 auto 10px auto;
    background-color: #f3f4f6;
    border-color: #e9ecef;
    transition: background 0.3s, border 0.3s;
}
body.light-theme .image-preview-container {
    background-color: #f3f4f6;
    border-color: #e9ecef;
}
body:not(.light-theme) .image-preview-container {
    background-color: #232323;
    border-color: #404040;
}
.preview-image {
    max-width: 180px;
    max-height: 180px;
    border-radius: 8px;
    display: block;
    margin: 0 auto;
}
.no-image-preview {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #adb5bd;
    font-size: 1.2rem;
    width: 100%;
    height: 100%;
}

    </style>
}

