@model Belloro.Models.Product

@{
    ViewData["Title"] = "Yeni Ürün Ekle";
    Layout = "~/Views/Shared/_adminlayout.cshtml";
}

<div class="container-fluid p-0">
    <div class="text-center mb-4">
        <h1 class="create-title mb-3">Yeni Ürün Ekle</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Products")" class="breadcrumb-link">
                        <i class="bi bi-list-ul me-1"></i>Ürün Listesi
                    </a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Yeni Ürün</li>
            </ol>
        </nav>
    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="create-form-container">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="form-group mb-4">
                        <label asp-for="Name" class="form-label">
                            <i class="bi bi-tag me-2"></i>Ürün Adı
                        </label>
                        <input asp-for="Name" class="form-control form-control-modern" placeholder="Ürün adını giriniz..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-4">
                        <label asp-for="Description" class="form-label">
                            <i class="bi bi-card-text me-2"></i>Açıklama
                        </label>
                        <textarea asp-for="Description" class="form-control form-control-modern" rows="4" placeholder="Ürün açıklamasını giriniz..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-4">
                        <label asp-for="Price" class="form-label">
                            <i class="bi bi-currency-exchange me-2"></i>Fiyat (TL)
                        </label>
                        <div class="input-group">
                            <input asp-for="Price" class="form-control form-control-modern" type="number" step="0.01" placeholder="0,00" />
                            <span class="input-group-text price-suffix">₺</span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-4">
                        <label asp-for="CategoryId" class="form-label">
                            <i class="bi bi-folder me-2"></i>Kategori
                        </label>
                        <select asp-for="CategoryId" class="form-select form-control-modern" asp-items="ViewBag.CategoryId">
                            <option value="">-- Kategori Seçin --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-4">
                        <label class="form-label"><i class="bi bi-image me-2"></i>Ürün Görseli</label>
                        <div class="image-upload-options mb-2">
                            <label class="form-label small text-muted">
                                <i class="bi bi-link-45deg me-1"></i>URL ile ekle (opsiyonel)
                            </label>
                            <input asp-for="ImageUrl" class="form-control form-control-modern mb-2" placeholder="Görsel URL'si giriniz" />
                        </div>
                        <div class="image-upload-options">
                            <label class="form-label small text-muted">
                                <i class="bi bi-upload me-1"></i>Dosya yükle
                            </label>
                            <input type="file" name="ImageFile" id="imageInput" class="form-control form-control-modern" accept="image/*" />
                        </div>
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-4">
                        <div class="checkbox-group">
                            <div class="form-check mb-3">
                                <input asp-for="IsFeatured" class="form-check-input modern-checkbox" type="checkbox" />
                                <label asp-for="IsFeatured" class="form-check-label">
                                    <i class="bi bi-star me-2"></i>Öne Çıkan Ürün
                                </label>
                            </div>
                            <div class="form-check">
                                <input asp-for="IsNew" class="form-check-input modern-checkbox" type="checkbox" />
                                <label asp-for="IsNew" class="form-check-label">
                                    <i class="bi bi-badge-wc me-2"></i>Yeni Ürün
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group mb-4 image-preview-wrapper">
                        <label class="form-label">
                            <i class="bi bi-eye me-2"></i>Görsel Önizleme
                        </label>
                        <div id="imageContainer" class="image-preview-container-square">
                            <div class="no-image-preview-square" id="noImageBox" style="display:flex;">
                                <i class="bi bi-image"></i>
                                <span>Resim Yok</span>
                            </div>
                        </div>
                        <div id="cancelButtonContainer">
                            <button type="button" id="cancelImageBtn" class="btn btn-cancel-image">
                                <i class="bi bi-x-circle me-2"></i>Seçimi İptal Et
                            </button>
                        </div>
                    </div>
                    <div class="form-actions text-center mt-4 pt-4">
                        <button type="submit" class="btn btn-warning btn-modern me-3">
                            <i class="bi bi-check-circle me-2"></i>Kaydet
                        </button>
                        <a asp-action="Index" class="btn btn-secondary btn-modern">
                            <i class="bi bi-arrow-left me-2"></i>Listeye Dön
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const imageInput = document.getElementById('imageInput');
            const imageUrlInput = document.querySelector('input[name="ImageUrl"]');
            const cancelButtonContainer = document.getElementById('cancelButtonContainer');
            const cancelImageBtn = document.getElementById('cancelImageBtn');
            const imageContainer = document.getElementById('imageContainer');
            const noImageBox = document.getElementById('noImageBox');

            function updateCancelBtnVisibility(visible) {
                cancelButtonContainer.style.display = visible ? 'flex' : 'none';
            }

            imageInput.addEventListener('change', function(event) {
                const file = event.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        showImagePreview(e.target.result);
                        imageUrlInput.value = '';
                    }
                    reader.readAsDataURL(file);
                }
            });

            imageUrlInput.addEventListener('input', function() {
                const url = this.value.trim();
                if (url) {
                    showImagePreview(url);
                    imageInput.value = '';
                } else {
                    hideImagePreview();
                }
            });

            cancelImageBtn.addEventListener('click', function() {
                imageInput.value = '';
                imageUrlInput.value = '';
                hideImagePreview();
            });

            function showImagePreview(src) {
                imageContainer.innerHTML = '';
                const img = document.createElement('img');
                img.src = src;
                img.className = 'preview-image-square';
                img.alt = 'Önizleme';
                img.onerror = function() {
                    hideImagePreview();
                    alert('Resim yüklenemedi. Lütfen geçerli bir URL girin veya farklı bir dosya seçin.');
                };
                imageContainer.appendChild(img);
                updateCancelBtnVisibility(true);
            }

            function hideImagePreview() {
                imageContainer.innerHTML = '';
                noImageBox.style.display = 'flex';
                imageContainer.appendChild(noImageBox);
                updateCancelBtnVisibility(false);
            }

            // Başlangıçta butonu gizle
            updateCancelBtnVisibility(false);
        });
    </script>
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        /* --- Products/Create.cshtml'e Özgü Stiller --- */
        .products-title {
            font-weight: 700;
            font-size: 2.5rem;
            margin-bottom: 1.5rem;
        }

        body.light-theme .products-title {
            color: #212529;
        }

        body:not(.light-theme) .products-title {
            color: #ffc107;
        }

        .btn-add-product {
            font-size: 1.1rem;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(255, 193, 7, 0.3);
            transition: all 0.3s ease;
        }

            .btn-add-product:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(255, 193, 7, 0.4);
            }

        .image-preview-wrapper {
            margin-bottom: 0;
        }

        .image-preview-container-square {
            border: 1.5px solid #e9ecef;
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            width: 250px;
            height: 250px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            margin: 0 auto;
            background-color: #f5f6f8;
            position: relative;
        }

        body:not(.light-theme) .image-preview-container-square {
            border: 1.5px solid #333;
            background: #292929;
        }

        .preview-image-square {
            max-width: 100%;
            max-height: 210px;
            object-fit: contain;
            border-radius: 8px;
        }

        .no-image-preview-square {
            display: flex;
            flex-direction: column;
            align-items: center;
            opacity: 0.6;
            margin-top: 0;
            margin-bottom: 0;
        }

            .no-image-preview-square i {
                font-size: 3rem;
                margin-bottom: 10px;
            }

            .no-image-preview-square span {
                font-size: 0.9rem;
            }

        #cancelButtonContainer {
            width: 100%;
            display: flex;
            justify-content: center;
            margin-top: 20px;
        }

        .btn-cancel-image {
            margin: 0 auto;
            display: flex;
            align-items: center;
            background: #fff;
            color: #dc3545;
            border: 1px solid #dc3545;
            border-radius: 6px;
            font-size: 0.9rem;
            font-weight: 500;
            box-shadow: 0 2px 8px rgba(44,45,48,0.08);
        }

            .btn-cancel-image:hover {
                background: #dc3545;
                color: #fff;
            }

        body:not(.light-theme) .btn-cancel-image {
            background: #262626;
        }

        /* --- Genel Form & Modern Tasarım (Category/Create.cshtml'den) --- */
        .create-title {
            font-weight: 700;
            font-size: 2.5rem;
            margin-bottom: 1.5rem;
            font-family: 'Nunito', sans-serif;
            letter-spacing: 1px;
        }

        body.light-theme .create-title {
            color: #212529;
        }

        body:not(.light-theme) .create-title {
            color: #ffc107;
        }

        .breadcrumb {
            background: none;
            padding: 0;
            margin-bottom: 0;
        }

        .breadcrumb-link {
            text-decoration: none;
            transition: color 0.2s;
        }

        body.light-theme .breadcrumb-link {
            color: #007bff;
        }

            body.light-theme .breadcrumb-link:hover {
                color: #ffc107;
            }

        body:not(.light-theme) .breadcrumb-link {
            color: #ffc107;
        }

            body:not(.light-theme) .breadcrumb-link:hover {
                color: #ffffff;
            }

        body.light-theme .breadcrumb-item.active {
            color: #6c757d;
        }

        body:not(.light-theme) .breadcrumb-item.active {
            color: #adb5bd;
        }

        .create-form-container {
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
        }

        body.light-theme .create-form-container {
            background-color: #ffffff;
            border: 1px solid #e9ecef;
        }

        body:not(.light-theme) .create-form-container {
            background-color: #2c2c2c;
            border: 1px solid #404040;
        }

        .form-label {
            font-weight: 600;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
        }

        body.light-theme .form-label {
            color: #212529;
        }

        body:not(.light-theme) .form-label {
            color: #ffc107;
        }

        .form-control-modern {
            border-radius: 8px;
            border: 2px solid;
            padding: 12px 16px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        body.light-theme .form-control-modern {
            background-color: #ffffff;
            border-color: #e9ecef;
            color: #212529;
        }

            body.light-theme .form-control-modern:focus {
                border-color: #ffc107;
                box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
            }

        body:not(.light-theme) .form-control-modern {
            background-color: #1a1a1a;
            border-color: #404040;
            color: #ffffff;
        }

            body:not(.light-theme) .form-control-modern:focus {
                border-color: #ffc107;
                box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
            }

        .form-text {
            font-size: 0.875rem;
            margin-top: 5px;
            display: flex;
            align-items: center;
        }

        body.light-theme .form-text {
            color: #6c757d;
        }

        body:not(.light-theme) .form-text {
            color: #adb5bd;
        }
        /* Modern Checkbox */
        .modern-checkbox {
            width: 1.2rem;
            height: 1.2rem;
            accent-color: #ffc107;
        }

        .form-check-label {
            font-weight: 500;
            margin-left: 0.5rem;
            display: flex;
            align-items: center;
            color: #212529;
        }

        body:not(.light-theme) .form-check-label {
            color: #ffc107;
        }
        /* Modern Butonlar */
        .btn-modern {
            font-size: 1.1rem;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

            .btn-modern::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
                transition: left 0.5s;
            }

            .btn-modern:hover::before {
                left: 100%;
            }

        .btn-warning.btn-modern {
            box-shadow: 0 4px 12px rgba(255, 193, 7, 0.3);
        }

            .btn-warning.btn-modern:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(255, 193, 7, 0.4);
            }

        .btn-secondary.btn-modern {
            box-shadow: 0 4px 12px rgba(108, 117, 125, 0.3);
        }

            .btn-secondary.btn-modern:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(108, 117, 125, 0.4);
            }
        /* Form Actions */
        .form-actions {
            border-top: 2px solid;
            margin-top: 30px;
            padding-top: 20px;
        }

        body.light-theme .form-actions {
            border-color: #e9ecef;
        }

        body:not(.light-theme) .form-actions {
            border-color: #404040;
        }

        .form-group.focused .form-label {
            color: #ffc107;
        }
        /* Responsive Tasarım */
        @@media (max-width: 768px) {
            .products-title, .create-title

        {
            font-size: 2rem;
        }

        .create-form-container {
            padding: 20px;
        }

        .btn-modern, .btn-add-product {
            padding: 10px 20px;
            font-size: 1rem;
        }

        .preview-image-square {
            max-height: 160px;
        }

        .image-preview-container-square {
            width: 150px;
            height: 150px;
            padding: 10px;
        }

        }
    </style>
}