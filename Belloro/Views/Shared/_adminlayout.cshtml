<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Belloro Yönetim</title>

    <!-- CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/assets/css/admin-style.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <!-- Belloro logosunu tıklanabilir yap - Dashboard'a gitsin -->
                <a href="/Admin/Dashboard" class="site-title-link">
                    <h1 class="site-title">Belloro</h1>
                </a>
                <i class='bx bx-menu toggle-sidebar' id="toggle-sidebar"></i>
            </div>

            <div class="sidebar-user">
                <div class="user-avatar">
                    <span>@(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")</span>
                </div>
                <div class="user-info">
                    <h3>@(User.Identity?.Name ?? "Admin")</h3>
                    <span>Yönetici</span>
                </div>
            </div>

            <ul class="sidebar-menu">
                <li class="menu-title">YÖNETİM</li>

                <li class="sidebar-item">
                    <a asp-controller="Admin" asp-action="Dashboard" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")">
                        <i class='bx bxs-dashboard'></i>
                        <span>Kontrol Paneli</span>
                    </a>
                </li>

                <li class="sidebar-item">
                    <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Products" ? "active" : "")">
                        <i class='bx bxs-watch'></i>
                        <span>Ürünler</span>
                    </a>
                </li>

                <li class="sidebar-item">
                    <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Category" ? "active" : "")">
                        <i class='bx bxs-category'></i>
                        <span>Kategoriler</span>
                    </a>
                </li>

                <li class="menu-title">MENÜ</li>

                <li class="sidebar-item">
                    <a asp-controller="Home" asp-action="Index" target="_blank" class="sidebar-link">
                        <i class='bx bx-window-open'></i>
                        <span>Siteye Dön</span>
                    </a>
                </li>

                <li class="sidebar-item">
                    <a href="javascript:void(0);" class="sidebar-link" id="theme-switch">
                        <i class='bx bx-moon change-theme' id="theme-button"></i>
                        <span>Tema</span>
                    </a>
                </li>

                <li class="sidebar-item">
                    <a asp-controller="Account" asp-action="Logout" class="sidebar-link logout-link">
                        <i class='bx bx-log-out'></i>
                        <span>Çıkış</span>
                    </a>
                </li>
            </ul>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <header class="content-header">
                <div class="content-header-left">
                    <h1 class="page-title">@ViewData["Title"]</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <!-- Ana Sayfa linki Admin Dashboard'a gitsin -->
                            <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Ana Sayfa</a></li>
                            <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                        </ol>
                    </nav>
                </div>
            </header>

            <div class="content-body">
                @RenderBody()
            </div>

            <footer class="content-footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-12 text-center">
                            <p class="mb-0">&copy; @DateTime.Now.Year - Belloro Yönetim Paneli</p>
                        </div>
                    </div>
                </div>
            </footer>
        </main>
    </div>

    <!-- JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/admin-sidebar.js" asp-append-version="true"></script>
    <script src="~/assets/js/admin-theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <style>
        /* Belloro logo tıklanabilir yapma stilleri */
        .site-title-link {
            text-decoration: none;
            color: inherit;
            transition: all 0.3s ease;
            display: block;
            border-radius: 8px;
            padding: 5px 10px;
            margin: -5px -10px;
        }

            .site-title-link:hover {
                text-decoration: none;
                color: inherit;
                transform: translateY(-1px);
            }

        /* Açık tema için hover efekti */
        body.light-theme .site-title-link:hover {
            background-color: rgba(255, 193, 7, 0.1);
            box-shadow: 0 4px 12px rgba(255, 193, 7, 0.2);
        }

        /* Koyu tema için hover efekti */
        body:not(.light-theme) .site-title-link:hover {
            background-color: rgba(255, 193, 7, 0.1);
            box-shadow: 0 4px 12px rgba(255, 193, 7, 0.3);
        }

        .site-title {
            margin: 0;
            font-weight: 700;
            font-size: 1.8rem;
            transition: all 0.3s ease;
        }

        .site-title-link:hover .site-title {
            transform: scale(1.05);
        }

        /* Logo için aktif durumda glow efekti */
        .site-title-link:active {
            transform: translateY(0);
        }

            .site-title-link:active .site-title {
                transform: scale(0.98);
            }

        /* Breadcrumb linklerinin hover efekti - ÇİZGİ KALDIRILDI */
        .breadcrumb-item a {
            transition: all 0.2s ease;
            text-decoration: none;
        }

        body.light-theme .breadcrumb-item a {
            color: #007bff;
        }

            body.light-theme .breadcrumb-item a:hover {
                color: #ffc107;
                /* text-decoration: underline; */
            }

        body:not(.light-theme) .breadcrumb-item a {
            color: #ffc107;
        }

            body:not(.light-theme) .breadcrumb-item a:hover {
                color: #ffffff;
                /* text-decoration: underline; */
            }

        
    </style>
</body>
</html>